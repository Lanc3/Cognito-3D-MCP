# Cognito-3D-mcp, Windows example. The installer configures absolute paths for you.
# For a manual installation, copy to .env in the server's working directory.
# python-dotenv expands ${LOCALAPPDATA} and ${USERPROFILE}; change these paths
# for another platform. Never commit .env or Hugging Face authentication tokens.
CODEX_3D_DATA_ROOT=${LOCALAPPDATA}/Cognito-3D-mcp

# Default multiview 3D backend. Names remain compatible with the bundled skills.
CODEX_HUNYUAN_MV_SERVER_NAME=codex-3d-models-hunyuan-mv
CODEX_HUNYUAN_MV_RUNTIME_ROOT=${CODEX_3D_DATA_ROOT}/runtime/hunyuan3d-2mv
CODEX_HUNYUAN_MV_PYTHON=${CODEX_HUNYUAN_MV_RUNTIME_ROOT}/venv/Scripts/python.exe
CODEX_HUNYUAN_MV_UPSTREAM=${CODEX_HUNYUAN_MV_RUNTIME_ROOT}/Hunyuan3D-2
CODEX_HUNYUAN_MV_MODEL_CACHE=${CODEX_3D_DATA_ROOT}/models/hunyuan3d-2mv
CODEX_HUNYUAN_MV_REPAIR_PACKAGES=${CODEX_3D_DATA_ROOT}/runtime/shape-repair-packages
CODEX_HUNYUAN_MV_OUTPUT_DIR=${CODEX_3D_DATA_ROOT}/outputs/hunyuan-mv
CODEX_HUNYUAN_MV_ALLOWED_INPUT_ROOTS=${CODEX_3D_DATA_ROOT}/inputs;${USERPROFILE}/.codex/generated_images
CODEX_HUNYUAN_MV_TEXTURE_SUBFOLDER=hunyuan3d-paint-v2-0
CODEX_HUNYUAN_MV_TEXTURE_RESOLUTION=2048
CODEX_HUNYUAN_MV_LOW_VRAM=false
CODEX_HUNYUAN_MV_TIMEOUT_SECONDS=2700
CODEX_HUNYUAN_MV_DASHBOARD_AUTO_OPEN=true
CODEX_AUTOREMESHER_EXE=${CODEX_3D_DATA_ROOT}/runtime/autoremesher/autoremesher.exe
CODEX_AUTOREMESHER_TARGET_QUADS=100000
CODEX_AUTOREMESHER_THREADS=2
CODEX_AUTOREMESHER_TIMEOUT=1800
CODEX_3D_GPU_LOCK=${CODEX_3D_DATA_ROOT}/runtime/gpu.lock
CODEX_GLTF_VALIDATOR=${CODEX_3D_DATA_ROOT}/runtime/gltf-validator/gltf_validator.exe
# Optional override; the installer locates Blender automatically.
# CODEX_BLENDER_EXE=C:/Program Files/Blender Foundation/Blender 5.1/blender.exe

# Optional legacy single-image backend. Select sf3d or spar3d explicitly.
CODEX_3D_BACKEND=sf3d
CODEX_3D_DEVICE=auto
CODEX_3D_LOW_VRAM_MODE=false
CODEX_3D_MODEL_CACHE_DIR=${CODEX_3D_DATA_ROOT}/models/sf3d
CODEX_3D_OUTPUT_DIR=${CODEX_3D_DATA_ROOT}/outputs/sf3d
CODEX_3D_ALLOWED_INPUT_ROOTS=${CODEX_3D_DATA_ROOT}/inputs;${USERPROFILE}/.codex/generated_images
CODEX_3D_MAX_IMAGE_BYTES=26214400
CODEX_3D_JOB_TIMEOUT_SECONDS=1800
CODEX_3D_POLL_SECONDS=2
CODEX_3D_MAX_QUEUED_JOBS=8
# SF3D/SPAR3D models require model-specific Hugging Face access.
# Authenticate outside this file: hf auth login (or huggingface-cli login).
# HF_TOKEN=hf_...

# Optional bidirectional 3D backend. TRELLIS-only installs select trellis;
# installations including SPAR3D can select spar3d with these runtime paths.
CODEX_TRELLIS_SERVER_NAME=codex-3d-models-trellis
CODEX_BIDIRECTIONAL_RECONSTRUCTION_BACKEND=trellis
CODEX_TRELLIS_RUNTIME_DIR=${CODEX_3D_DATA_ROOT}/runtime/trellis-v0.5.4
CODEX_TRELLIS_MODEL_DIR=${CODEX_3D_DATA_ROOT}/models/trellis2-q8
CODEX_TRELLIS_OUTPUT_DIR=${CODEX_3D_DATA_ROOT}/outputs/trellis
CODEX_TRELLIS_ALLOWED_INPUT_ROOTS=${CODEX_3D_DATA_ROOT}/inputs;${USERPROFILE}/.codex/generated_images
CODEX_TRELLIS_PORT=18082
CODEX_TRELLIS_TIMEOUT_SECONDS=1800
CODEX_BIDIRECTIONAL_SPAR3D_PYTHON=${CODEX_3D_DATA_ROOT}/runtime/spar3d/venv/Scripts/python.exe
CODEX_BIDIRECTIONAL_SPAR3D_MODEL_CACHE=${CODEX_3D_DATA_ROOT}/models/spar3d
CODEX_BIDIRECTIONAL_SPAR3D_MODEL_ID=stabilityai/stable-point-aware-3d
CODEX_BIDIRECTIONAL_SPAR3D_LOW_VRAM_MODE=true
CODEX_REALESRGAN_EXE=${CODEX_3D_DATA_ROOT}/runtime/realesrgan-v0.2.5.0/realesrgan-ncnn-vulkan.exe
